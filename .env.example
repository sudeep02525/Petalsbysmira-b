# Petals by Smira - Backend Environment Variables
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/petalsbysmira?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRE=30d

# Frontend & Admin URLs for CORS and email links
FRONTEND_URL=https://petalsbysmira.in
ADMIN_URL=https://admin.petalsbysmira.in

# Cloudinary (Media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (Email service for private access links & admin reset OTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Petals by Smira <concierge@petalsbysmira.in>

